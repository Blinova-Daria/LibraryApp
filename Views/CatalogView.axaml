<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LibraryApp.Views.CatalogView"
             Tag="Каталог">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Classes="heading" Text="Каталог изданий" />
      <TextBox x:Name="SearchBox"
               PlaceholderText="Поиск по названию или автору"
               TextChanged="SearchChanged" />
      <Grid ColumnDefinitions="*,300,Auto" Margin="0,0,0,8">
        <ComboBox x:Name="GenreBox" HorizontalAlignment="Stretch"
                  SelectionChanged="FilterChanged" />
        <ComboBox x:Name="SortBox" Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="FilterChanged">
          <ComboBoxItem Content="По названию" />
          <ComboBoxItem Content="По году издания (новые)" />
          <ComboBoxItem Content="Сначала со свободными" />
        </ComboBox>
        <Button Grid.Column="2" Content="Обновить"
                Click="ReloadClick" />
      </Grid>
      <TextBlock x:Name="CountText" />
    </StackPanel>

    <ListBox x:Name="CardsList">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{Binding Background}" Padding="12"
                  Margin="0,4">
            <Grid ColumnDefinitions="110,*,200">
              <Image Source="{Binding Image}" Width="100" Height="140"
                     Stretch="Uniform" />
              <StackPanel Grid.Column="1" Spacing="4" Margin="12,0">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                <TextBlock Text="{Binding Authors}" />
                <TextBlock Text="{Binding Genre}" />
                <TextBlock Text="{Binding Publisher}" />
                <TextBlock Text="{Binding Description}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding FreeText}" FontWeight="Bold" />
                <Button Content="Забронировать" Click="BookClick"
                        IsVisible="{Binding CanReserve}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
