<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LibraryApp.Views.DictionariesView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Classes="heading" Text="Справочники" />
      <WrapPanel>
        <ComboBox x:Name="KindBox" Width="190" Margin="0,0,6,6"
                  SelectionChanged="KindChanged" />
        <TextBox x:Name="NameBox" Watermark="Название" Width="220" Margin="0,0,6,6" />
        <TextBox x:Name="ExtraBox" Watermark="Город (для издательств)" Width="190" Margin="0,0,6,6" />
        <Button Content="Добавить" Classes="accent" Click="AddClick" />
      </WrapPanel>
    </StackPanel>
    <ListBox x:Name="DictList">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,140" Margin="0,3">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="Bold" />
              <TextBlock Text="{Binding Extra}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Удалить" Click="DeleteClick" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
